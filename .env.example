APNS_TEAM_ID=YOUR_TEAM_ID
APNS_KEY_ID=YOUR_KEY_ID
APNS_BUNDLE_ID=com.example.app
ADDITIONAL_BUNDLE_IDS=
APNS_PRIVATE_KEY_PATH=/run/secrets/AuthKey.p8
APNS_PRIVATE_KEY=
DATABASE_PATH=/data/apns.db
API_KEY=change-this-to-a-long-random-secret
APP_ATTEST_ENABLED=false
APP_ATTEST_ENVIRONMENT=development
# Optional; defaults to APNS_TEAM_ID.APNS_BUNDLE_ID.
APP_ATTEST_APP_ID=
APP_ATTEST_CHALLENGE_TTL_SECONDS=300
APNS_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
PUBLIC_DOMAIN=your-hostname.ddnsfree.com
